# PostgreSQL Database Connection String (Neon or Docker internal)
# Format: jdbc:postgresql://<host>:<port>/<database>?user=<user>&password=<password>&sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/stockpulse?user=stockpulse&password=stockpulse

# LLM Gateway Configuration
LLM_PROVIDER=litellm
LLM_BASE_URL=https://litellm-qc.zycus.net
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=qwen-cursor

# Optional Strategy Configuration (RULE_BASED or AI)
STOCKPULSE_COMMERCE_STRATEGY=RULE_BASED