# StockPulse Root Environment Configuration

# PostgreSQL Database Connection String (Optional: override for external database like Neon)
# If left unset, Docker Compose connects to the internal 'db' PostgreSQL container.
# DATABASE_URL=jdbc:postgresql://db:5432/stockpulse?user=stockpulse&password=stockpulse

# LLM Gateway Configuration
LLM_PROVIDER=litellm
LLM_BASE_URL=https://litellm-qc.zycus.net
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=qwen-cursor

# Commerce Advisor Strategy (RULE_BASED or AI)
STOCKPULSE_COMMERCE_STRATEGY=RULE_BASED
